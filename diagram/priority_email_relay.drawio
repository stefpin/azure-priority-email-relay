xitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b_ing" target="b_sb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="dequeue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0857C3;strokeWidth=1.6;fontSize=8;fontColor=#0857C3;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="b_sb" target="b_worker"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="fetch payload" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44566B;strokeWidth=1.6;fontSize=8;fontColor=#44566B;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=4 4;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b_worker" target="b_blob"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="take token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#15803D;strokeWidth=1.6;fontSize=8;fontColor=#15803D;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=4 4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b_redis" target="b_worker"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="REST + HMAC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0857C3;strokeWidth=1.6;fontSize=8;fontColor=#0857C3;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b_worker" target="b_acs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s3" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#233A51;strokeColor=none;fontColor=#FFFFFF;fontSize=9;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="290" y="469" width="20" height="20" as="geometry"/></mxCell><mxCell id="s4" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#233A51;strokeColor=none;fontColor=#FFFFFF;fontSize=9;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="469" width="20" height="20" as="geometry"/></mxCell><mxCell id="s5" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#233A51;strokeColor=none;fontColor=#FFFFFF;fontSize=9;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1092" y="469" width="20" height="20" as="geometry"/></mxCell><mxCell id="s6" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#233A51;strokeColor=none;fontColor=#FFFFFF;fontSize=9;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1350" y="469" width="20" height="20" as="geometry"/></mxCell><mxCell id="bulk_note" value="&lt;b&gt;Why the payload never rides the queue.&lt;/b&gt; the customer averages several hundred KB a message, which exceeds the Service Bus Standard limit of 256 KB. The blob holds the message and the queue holds only a pointer &#8212; the claim-check pattern." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0857C3;strokeWidth=1;arcSize=8;align=left;verticalAlign=middle;fontSize=8.5;fontColor=#233A51;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="90" y="636" width="700" height="46" as="geometry"/></mxCell><mxCell id="bulk_note2" value="&lt;b&gt;The rate governor is the whole point.&lt;/b&gt; Every worker replica draws from one shared Redis bucket, so the pool can never outrun the ACS quota however many replicas KEDA starts." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1FAF4;strokeColor=#15803D;strokeWidth=1;arcSize=8;align=left;verticalAlign=middle;fontSize=8.5;fontColor=#233A51;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="830" y="636" width="640" height="46" as="geometry"/></mxCell><mxCell id="lane_plat" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#44566B;strokeWidth=1.5;arcSize=2;" vertex="1" parent="1"><mxGeometry x="30" y="716" width="1780" height="226" as="geometry"/></mxCell><mxCell id="lane_plat_t" value="SHARED PLATFORM" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#44566B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="44" y="724" width="320" height="18" as="geometry"/></mxCell><mxCell id="lane_plat_s" value="network, identity, build and telemetry &#183; used by both lanes" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=8.5;fontColor=#44566B;" vertex="1" parent="1"><mxGeometry x="44" y="743" width="340" height="16" as="geometry"/></mxCell><mxCell id="p_vnet" value="vnet-relay-demo
